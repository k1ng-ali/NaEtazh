# ─── Настройки сервера ─────────────────────────────────────────────────────────
# setup.sh создаёт из этого файла deploy/.env: подставляет логин Docker Hub, адрес сайта,
# пароль базы и SECRET_KEY. Руками менять только то, что ниже помечено.

# ─── Образы ────────────────────────────────────────────────────────────────────
DOCKERHUB_USERNAME=your-dockerhub-login
IMAGE_TAG=latest
# Порты сайта на сервере
HTTP_PORT=80
HTTPS_PORT=443
# Настройки nginx: http до выпуска сертификата, https ставит ssl.sh
NGINX_SITE=http

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=stroybaza
POSTGRES_PASSWORD=__DB_PASSWORD__
POSTGRES_DB=stroybaza

# ─── Backend ───────────────────────────────────────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_USER=stroybaza
DB_PASSWORD=__DB_PASSWORD__
DB_NAME=stroybaza

SECRET_KEY=__SECRET_KEY__
DEV_MODE=false
# По http — false, иначе вход сотрудников не работает. ssl.sh ставит true
COOKIE_SECURE=false
CORS_ORIGINS=__SITE_URL__
# Адрес сайта для ссылок в уведомлениях
SITE_URL=__SITE_URL__
# Новые заказы в Telegram: токен от @BotFather и id чата менеджера. Пусто — не отправляем
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Frontend ──────────────────────────────────────────────────────────────────
NUXT_API_INTERNAL_URL=http://backend:8000/api/v1
# Браузер ходит в API через nginx того же адреса
NUXT_PUBLIC_API_URL=/api/v1
# Фото отдаёт nginx того же адреса
NUXT_PUBLIC_MEDIA_URL=
# Адрес сайта в QR-кодах корпусов
NUXT_PUBLIC_SITE_URL=__SITE_URL__
# Номер счётчика Яндекс Метрики. Пусто — Метрика выключена
NUXT_PUBLIC_METRIKA_ID=
