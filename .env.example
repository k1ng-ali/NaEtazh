# ─── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=stroybaza
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stroybaza

# ─── Backend ───────────────────────────────────────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_USER=stroybaza
DB_PASSWORD=change-me
DB_NAME=stroybaza

# Сгенерировать: openssl rand -hex 32
SECRET_KEY=change-me
# Для локальной разработки, на сервере false
DEV_MODE=true
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Адрес сайта для ссылок в уведомлениях
SITE_URL=http://localhost:3000
# Новые заказы в Telegram: токен от @BotFather и id чата менеджера. Пусто — не отправляем
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Frontend ──────────────────────────────────────────────────────────────────
# Адрес API для серверного рендеринга внутри Docker
NUXT_API_INTERNAL_URL=http://backend:8000/api/v1
# Адрес API для браузера
NUXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Откуда браузер берёт загруженные фото. На сервере пусто: их отдаёт nginx того же домена
NUXT_PUBLIC_MEDIA_URL=http://localhost:8000
# Адрес сайта в QR-кодах корпусов: на сервере — боевой домен
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Только сервер ─────────────────────────────────────────────────────────────
DOCKERHUB_USERNAME=your-dockerhub-login
IMAGE_TAG=latest
